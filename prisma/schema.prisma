generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ================== MODELOS BASE ==================
 */

model Empresa {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  movimientos Movimiento[]
  enCola      Ronda[]
  usuarios    Usuario[]
  servicios   ServicioCola[]
}

model Localidad {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  estado      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  movimientos Movimiento[]
  usuarios    Usuario[]
  vias        Via[]
  rondas      Ronda[]
  servicios   ServicioCola[]

  // Back-relations necesarios para evitar errores
  tornosT            TornoT[]
  lavadosT           LavadoT[]
  navajas            Navaja[]
  incidentesTorno    IncidenteTorno[]
  incidentesLavado   IncidenteLavado[]
  seguimientosTorno  SeguimientoTorno[]
  seguimientosLavado SeguimientoLavado[]

  @@index([nombre])
}

model Usuario {
  id                 Int                 @id @default(autoincrement())
  nombre             String              @unique
  email              String              @unique
  contrasena         String
  rol                Rol
  empresaId          Int
  localidadId        Int
  fcmTokens          FcmToken[]
  activo             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  incidentes         Incidente[]
  movimientos        Movimiento[]        @relation("UsuarioMovimiento")
  coordinadorMovs    Movimiento[]        @relation("CoordinadorMovimiento")
  creados            Movimiento[]        @relation("UsuarioCreador")
  operadorMovs       Movimiento[]        @relation("OperadorMovimiento")
  supervisorMovs     Movimiento[]        @relation("SupervisorMovimiento")
  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  localidad          Localidad           @relation(fields: [localidadId], references: [id])
  incidentesTorno    IncidenteTorno[]
  incidentesLavado   IncidenteLavado[]
  seguimientosTorno  SeguimientoTorno[]
  seguimientosLavado SeguimientoLavado[]
  tokenVersion       Int                 @default(0)
  ips                IpUsuario[]
  tokens             Token[]

  @@index([empresaId, activo])
  @@index([localidadId, rol])
}

model FcmToken {
  id          Int      @id @default(autoincrement())
  token       String   @unique @db.VarChar(500)
  usuarioId   Int
  localidadId Int?
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([usuarioId])
  @@index([localidadId])
}

model Via {
  id           Int         @id @default(autoincrement())
  numero       Int
  nombre       String
  localidadId  Int
  ocupada      Boolean     @default(false)
  movimientoId Int?
  movimiento   Movimiento? @relation("ViaOcupante", fields: [movimientoId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  secciones          SeccionVia[]
  movimientosDestino Movimiento[] @relation("ViaDestinoMovimiento")
  movimientosOrigen  Movimiento[] @relation("ViaOrigenMovimiento")
  localidad          Localidad    @relation(fields: [localidadId], references: [id])

  @@unique([numero, localidadId])
  @@unique([nombre, localidadId])
  @@index([movimientoId])
  @@index([localidadId, numero])
}

model SeccionVia {
  id           Int         @id @default(autoincrement())
  viaId        Int
  numero       Int
  nombre       String?
  ocupada      Boolean     @default(false)
  movimientoId Int?
  movimiento   Movimiento? @relation("SeccionOcupante", fields: [movimientoId], references: [id], onDelete: SetNull)
  via          Via         @relation(fields: [viaId], references: [id], onDelete: Cascade)

  @@unique([viaId, numero])
  @@index([viaId, ocupada])
  @@index([viaId, movimientoId])
  @@index([viaId, movimientoId, ocupada])
}

model Movimiento {
  id               Int               @id @default(autoincrement())
  empresaId        Int
  creadoPorId      Int
  clienteId        Int?
  supervisorId     Int?
  coordinadorId    Int?
  operadorId       Int?
  localidadId      Int
  viaOrigenId      Int?
  viaDestinoId     Int?
  locomotiveNumber Int
  lavado           Boolean?          @default(false)
  torno            Boolean?          @default(false)
  prioridad        Prioridad         @default(BAJA)
  tipoMovimiento   TipoMovimiento?
  estado           EstadoMovimiento  @default(SOLICITADO)
  fechaSolicitud   DateTime          @default(now())
  fechaInicio      DateTime?
  fechaFin         DateTime?
  fechaPausa       DateTime?
  instrucciones    String?
  posicionChimenea PosicionChimenea?
  finalizado       Boolean?          @default(false)
  incidenteGlobal  Boolean?          @default(false)
  direccionEmpuje  DireccionEmpuje?  @default(Sin_Solicitar)
  posicionCabina   PosicionCabina?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  incidentes      Incidente[]
  incidentesTorno IncidenteTorno[]
  cliente         Usuario?         @relation("UsuarioMovimiento", fields: [clienteId], references: [id], onDelete: Restrict)
  coordinador     Usuario?         @relation("CoordinadorMovimiento", fields: [coordinadorId], references: [id], onDelete: Restrict)
  creadoPor       Usuario          @relation("UsuarioCreador", fields: [creadoPorId], references: [id])
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  localidad       Localidad        @relation(fields: [localidadId], references: [id])
  operador        Usuario?         @relation("OperadorMovimiento", fields: [operadorId], references: [id], onDelete: Restrict)
  supervisor      Usuario?         @relation("SupervisorMovimiento", fields: [supervisorId], references: [id], onDelete: Restrict)
  viaDestino      Via?             @relation("ViaDestinoMovimiento", fields: [viaDestinoId], references: [id], onDelete: Restrict)
  viaOrigen       Via?             @relation("ViaOrigenMovimiento", fields: [viaOrigenId], references: [id])
  ronda           Ronda?
  servicio        ServicioCola?

  viaOcupante        Via[]        @relation("ViaOcupante")
  seccionesOcupantes SeccionVia[] @relation("SeccionOcupante")

  tornos  TornoT[]
  lavados LavadoT[]

  @@index([empresaId, estado])
  @@index([fechaInicio, fechaFin])
  @@index([estado, finalizado])
  @@index([clienteId, estado])
  @@index([supervisorId, estado])
  @@index([coordinadorId, estado])
  @@index([operadorId, estado])
  @@index([localidadId, estado])
  @@index([viaOrigenId, viaDestinoId])
}

model Incidente {
  id           Int             @id @default(autoincrement())
  descripcion  String
  imagen1      String?
  imagen2      String?
  imagen3      String?
  imagen4      String?
  movimientoId Int
  usuarioId    Int
  estado       EstadoIncidente @default(ABIERTO)
  fechaInicio  DateTime        @default(now())
  fechaFin     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movimiento   Movimiento      @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  usuario      Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([estado, fechaInicio])
  @@index([movimientoId, estado])
}

model Ronda {
  id           Int      @id @default(autoincrement())
  movimientoId Int      @unique
  empresaId    Int
  localidadId  Int
  concluido    Boolean? @default(false)
  orden        Int
  rondaNumero  Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimiento Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  localidad  Localidad  @relation(fields: [localidadId], references: [id], onDelete: Restrict)

  @@index([rondaNumero, orden])
  @@index([localidadId])
}

model ServicioCola {
  id           Int            @id @default(autoincrement())
  localidadId  Int
  empresaId    Int
  movimientoId Int            @unique
  tipo         ServicioTipo
  estado       ServicioEstado @default(EN_SERVICIO)
  orden        Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  localidad  Localidad  @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimiento Movimiento @relation(fields: [movimientoId], references: [id], onDelete: Cascade)

  @@index([localidadId, tipo, estado, orden])
  @@index([empresaId, estado])
}

/**
 * ================== TOKENS ==================
 */

enum TokenTipo {
  ACCESS
}

enum DeviceType {
  WEB
  ANDROID
  IOS
  DESKTOP
  OTHER
}

model Token {
  jti       String     @id @db.Uuid
  usuarioId Int
  tipo      TokenTipo  @default(ACCESS)
  scope     String?    @db.VarChar(256)
  ip        String?    @db.Inet
  ua        String?    @db.VarChar(512)
  deviceId  String?    @db.VarChar(128)
  platform  DeviceType
  issuedAt  DateTime   @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  reason    String?    @db.VarChar(64)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, platform], map: "uniq_user_platform")
  @@index([usuarioId, expiresAt, revokedAt])
  @@index([expiresAt])
  @@index([ip])
  @@index([deviceId])
}

model IpUsuario {
  usuarioId       Int
  ip              String     @db.Inet
  tipoDispositivo DeviceType
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, ip, tipoDispositivo])
  @@index([ip])
}

model Actualizacion {
  id               Int                 @id @default(autoincrement())
  nombre           String
  fechalanzamiento DateTime
  estado           EstadoActualizacion @default(ACTIVA)

  @@map("actualizacion")
}

/**
 * ================== NUEVOS Y AJUSTES ==================
 */

// TornoT: +localidadId
model TornoT {
  id           Int            @id @default(autoincrement())
  movimientoId Int
  localidadId  Int
  status       ServicioEstado @default(EN_SERVICIO)
  inicio       DateTime?
  fin          DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  movimiento   Movimiento         @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  localidad    Localidad          @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  incidentes   IncidenteTorno[]
  seguimientos SeguimientoTorno[]

  // NUEVO: lados inversos para las medidas
  medidasI MedidasTornoI[]
  medidasF MedidasTornoF[]

  @@index([movimientoId])
  @@index([movimientoId, createdAt])
  @@index([movimientoId, status])
  @@index([localidadId, status, createdAt])
}

// LavadoT: +localidadId
model LavadoT {
  id           Int            @id @default(autoincrement())
  movimientoId Int
  localidadId  Int
  status       ServicioEstado @default(EN_SERVICIO)
  inicio       DateTime?
  fin          DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  movimiento   Movimiento          @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  localidad    Localidad           @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  incidentes   IncidenteLavado[]
  seguimientos SeguimientoLavado[]

  @@index([movimientoId, status])
  @@index([localidadId, status, createdAt])
}

// Navaja: +localidadId y unicidad por localidad
model Navaja {
  id                   Int       @id @default(autoincrement())
  numero               Int
  localidadId          Int
  ultimoMantenimiento  DateTime?
  proximoMantenimiento DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  localidad Localidad @relation(fields: [localidadId], references: [id], onDelete: Restrict)

  @@unique([numero, localidadId])
}

// IncidenteTorno: +localidadId y seguimientos
model IncidenteTorno {
  id           Int             @id @default(autoincrement())
  movimientoId Int
  tornoId      Int
  usuarioId    Int
  localidadId  Int
  comentarios  String?
  fotos        String[]
  status       EstadoIncidente @default(ABIERTO)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  movimiento   Movimiento         @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  torno        TornoT             @relation(fields: [tornoId], references: [id], onDelete: Cascade)
  usuario      Usuario            @relation(fields: [usuarioId], references: [id])
  localidad    Localidad          @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  seguimientos SeguimientoTorno[]

  @@index([movimientoId, status])
  @@index([tornoId])
  @@index([tornoId, createdAt])
  @@index([localidadId, status, createdAt])
}

// IncidenteLavado: +localidadId y seguimientos
model IncidenteLavado {
  id          Int             @id @default(autoincrement())
  lavadoId    Int
  usuarioId   Int
  localidadId Int
  comentarios String?
  imagenes    String[]
  status      EstadoIncidente @default(ABIERTO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lavado       LavadoT             @relation(fields: [lavadoId], references: [id], onDelete: Cascade)
  usuario      Usuario             @relation(fields: [usuarioId], references: [id])
  localidad    Localidad           @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  seguimientos SeguimientoLavado[]

  @@index([lavadoId])
  @@index([lavadoId, createdAt])
  @@index([lavadoId, status])
  @@index([localidadId, status, createdAt])
}

/**
 * ============ NUEVAS TABLAS DE SEGUIMIENTO ============
 */

model SeguimientoTorno {
  id          Int               @id @default(autoincrement())
  incidenteId Int
  tornoId     Int
  localidadId Int
  actorId     Int
  accion      AccionSeguimiento
  comentario  String?
  imagenes    String[]
  deStatus    EstadoIncidente?
  aStatus     EstadoIncidente?
  createdAt   DateTime          @default(now())

  incidente IncidenteTorno @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  torno     TornoT         @relation(fields: [tornoId], references: [id], onDelete: Cascade)
  localidad Localidad      @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  actor     Usuario        @relation(fields: [actorId], references: [id])

  @@index([incidenteId, createdAt])
  @@index([localidadId, accion, createdAt])
  @@index([actorId, createdAt])
}

model SeguimientoLavado {
  id          Int               @id @default(autoincrement())
  incidenteId Int
  lavadoId    Int
  localidadId Int
  actorId     Int
  accion      AccionSeguimiento
  comentario  String?
  imagenes    String[]
  deStatus    EstadoIncidente?
  aStatus     EstadoIncidente?
  createdAt   DateTime          @default(now())

  incidente IncidenteLavado @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  lavado    LavadoT         @relation(fields: [lavadoId], references: [id], onDelete: Cascade)
  localidad Localidad       @relation(fields: [localidadId], references: [id], onDelete: Restrict)
  actor     Usuario         @relation(fields: [actorId], references: [id])

  @@index([incidenteId, createdAt])
  @@index([localidadId, accion, createdAt])
  @@index([actorId, createdAt])
}

/**
 * ============ NUEVAS TABLAS DE MEDIDAS ============
 */

model MedidasTornoI {
  id        Int      @id @default(autoincrement())
  id_TornoT Int
  L1        String
  R1        String
  L2        String
  R2        String
  L3        String
  R3        String
  L4        String
  R4        String
  L5        String
  R5        String
  L6        String
  R6        String
  creadoEn  DateTime @default(now())

  torno TornoT @relation(fields: [id_TornoT], references: [id], onDelete: Cascade)

  @@index([id_TornoT])
}

model MedidasTornoF {
  id        Int      @id @default(autoincrement())
  id_TornoT Int
  L1        String
  R1        String
  L2        String
  R2        String
  L3        String
  R3        String
  L4        String
  R4        String
  L5        String
  R5        String
  L6        String
  R6        String
  creadoEn  DateTime @default(now())

  torno TornoT @relation(fields: [id_TornoT], references: [id], onDelete: Cascade)

  @@index([id_TornoT])
}

/**
 * ================== ENUMS ==================
 */

enum EstadoActualizacion {
  ACTIVA
  DESACTUALIZADA
}

enum EstadoIncidente {
  ABIERTO
  CERRADO
  RESUELTO
}

enum Prioridad {
  BAJA
  ALTA
}

enum EstadoMovimiento {
  SOLICITADO
  EN_PROCESO
  DETENIDO
  ESPERA
  MODIFICADO
  CONCLUIDO
  CANCELADO
  AGENDADO
}

enum Lavado {
  POSICION_UNO
  POSICION_DOS
}

enum Rol {
  CLIENTE
  CLIENTE_ADMIN
  CLIENTE_COOR
  ARRASTRE_TORREON
  SUPERVISOR
  COORDINADOR
  OPERADOR
  MAQUINISTA
  MAQUINISTA_ARRASTRE
  ADMINISTRADOR
  LAVADO
  TORNO
}

enum PosicionCabina {
  Sin_Solicitar
  DENTRO
  AFUERA
}

enum PosicionChimenea {
  Sin_Solicitar
  DENTRO
  AFUERA
}

enum DireccionEmpuje {
  Sin_Solicitar
  EMPUJAR
  JALAR
}

enum TipoMovimiento {
  MD_TRABAJANDO
  REMOLCADA
}

enum ServicioTipo {
  LAVADO
  TORNO
}

enum ServicioEstado {
  DETENIDO
  EN_SERVICIO
  FINALIZADO
}

enum AccionSeguimiento {
  COMENTARIO
  CAMBIO_STATUS
  ADJUNTO
  ASIGNACION
  CIERRE
  REAPERTURA
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("COMERCIAL_DATABASE_URL")
}

enum TipoContactoComercial {
  COMERCIAL
  FACTURACION
  COBRANZA
  OPERATIVO
  OTRO
}

enum EstadoContratoComercial {
  BORRADOR
  VIGENTE
  VENCIDO
  CANCELADO
}

enum TipoServicioComercial {
  MOVIMIENTO
  LAVADO
  TORNEADO
  DETENCION
  CANCELACION
  OTRO
}

enum UnidadCobro {
  EVENTO
  MOVIMIENTO
  VAGON
  SERVICIO
  HORA
  DIA
  LOCOMOTORA
  TARIFA_FIJA
}

enum PeriodicidadPlan {
  UNICO
  SEMANAL
  MENSUAL
  ANUAL
}

enum EstadoPlanComercial {
  BORRADOR
  APROBADO
  EN_EJECUCION
  COMPLETADO
  CANCELADO
}

enum EstadoDetallePlan {
  PLANEADO
  ASIGNADO
  EJECUTADO
  CANCELADO
  NO_REALIZADO
}

enum EstadoCobroComercial {
  PENDIENTE_VALIDACION
  COBRABLE
  NO_COBRABLE
  EN_ACLARACION
  APROBADO
  FACTURADO
  PAGADO
  VENCIDO
}

enum OrigenOperacionComercial {
  NATURAL
  ARRASTRE
}

enum PeriodicidadPaquete {
  UNICO
  SEMANAL
  MENSUAL
  BIMESTRAL
  SEMESTRAL
  ANUAL
  VIGENCIA_COMPLETA
}

enum EstadoCorteCobro {
  BORRADOR
  EN_REVISION
  APROBADO
  FACTURADO
  PARCIAL
  PAGADO
  VENCIDO
  CANCELADO
}

enum EstadoGestionCobranza {
  PENDIENTE
  PROMESA_PAGO
  EN_ACLARACION
  RESUELTA
}

model ClienteComercial {
  id                  Int      @id @default(autoincrement())
  empresaId           Int      @unique
  empresaNombre       String
  razonSocial         String?
  rfc                 String?  @unique
  moneda              String   @default("MXN") @db.VarChar(3)
  diasCredito         Int      @default(0)
  correoFacturacion   String?
  correoCobranza      String?
  requiereOrdenCompra Boolean  @default(false)
  notas               String?
  activo              Boolean  @default(true)
  createdById         Int
  updatedById         Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  contactos         ContactoCliente[]
  contratos         ContratoComercial[]
  tarifas           TarifaCliente[]
  planes            PlanComercial[]
  paquetes          PaqueteComercial[]
  cortes            CorteCobro[]
  gestionesCobranza GestionCobranza[]

  @@index([activo, empresaNombre])
  @@index([rfc])
}

model ContactoCliente {
  id                 Int                   @id @default(autoincrement())
  clienteComercialId Int
  nombre             String
  puesto             String?
  tipo               TipoContactoComercial @default(COMERCIAL)
  email              String?
  telefono           String?
  principal          Boolean               @default(false)
  activo             Boolean               @default(true)
  createdById        Int
  updatedById        Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  cliente ClienteComercial @relation(fields: [clienteComercialId], references: [id], onDelete: Cascade)

  @@index([clienteComercialId, activo])
  @@index([clienteComercialId, tipo])
}

model ContratoComercial {
  id                 Int                     @id @default(autoincrement())
  clienteComercialId Int
  folio              String
  nombre             String
  ordenCompra        String?
  fechaInicio        DateTime
  fechaFin           DateTime?
  estado             EstadoContratoComercial @default(BORRADOR)
  moneda             String                  @default("MXN") @db.VarChar(3)
  montoMaximo        Decimal?                @db.Decimal(14, 2)
  diaCorte           Int?
  documentoUrl       String?
  notas              String?
  createdById        Int
  updatedById        Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  cliente  ClienteComercial   @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  tarifas  TarifaCliente[]
  planes   PlanComercial[]
  paquetes PaqueteComercial[]
  cortes   CorteCobro[]

  @@unique([clienteComercialId, folio])
  @@index([clienteComercialId, estado, fechaInicio])
  @@index([fechaFin])
}

model TarifaCliente {
  id                 Int                   @id @default(autoincrement())
  clienteComercialId Int
  contratoId         Int?
  servicio           TipoServicioComercial
  concepto           String
  unidad             UnidadCobro           @default(EVENTO)
  localidadId        Int?
  tipoMovimiento     String?
  importeUnitario    Decimal               @db.Decimal(14, 2)
  porcentajeIva      Decimal               @default(16) @db.Decimal(5, 2)
  moneda             String                @default("MXN") @db.VarChar(3)
  vigenciaInicio     DateTime
  vigenciaFin        DateTime?
  cantidadMinima     Decimal?              @db.Decimal(12, 2)
  importeMinimo      Decimal?              @db.Decimal(14, 2)
  activo             Boolean               @default(true)
  notas              String?
  createdById        Int
  updatedById        Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  cliente           ClienteComercial       @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  contrato          ContratoComercial?     @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  detallesPlan      PlanComercialDetalle[]
  paquetesExcedente PaqueteComercial[]

  @@index([clienteComercialId, servicio, activo])
  @@index([clienteComercialId, localidadId, vigenciaInicio, vigenciaFin])
  @@index([contratoId])
}

model PlanComercial {
  id                 Int                 @id @default(autoincrement())
  clienteComercialId Int
  contratoId         Int?
  folio              String              @unique
  nombre             String
  periodicidad       PeriodicidadPlan    @default(UNICO)
  fechaInicio        DateTime
  fechaFin           DateTime
  estado             EstadoPlanComercial @default(BORRADOR)
  ordenCompra        String?
  notas              String?
  aprobadoPorId      Int?
  aprobadoAt         DateTime?
  createdById        Int
  updatedById        Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  cliente  ClienteComercial       @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  contrato ContratoComercial?     @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  detalles PlanComercialDetalle[]

  @@index([clienteComercialId, estado, fechaInicio])
  @@index([contratoId])
  @@index([fechaInicio, fechaFin])
}

model PlanComercialDetalle {
  id                      Int                   @id @default(autoincrement())
  planId                  Int
  tarifaId                Int?
  servicio                TipoServicioComercial
  locomotoraNumero        Int?
  localidadId             Int?
  viaOrigen               String?
  viaDestino              String?
  fechaProgramada         DateTime
  cantidad                Decimal               @default(1) @db.Decimal(12, 2)
  importeUnitarioAcordado Decimal?              @db.Decimal(14, 2)
  estado                  EstadoDetallePlan     @default(PLANEADO)
  movimientoId            Int?
  notas                   String?
  createdById             Int
  updatedById             Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  plan   PlanComercial  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tarifa TarifaCliente? @relation(fields: [tarifaId], references: [id], onDelete: SetNull)

  @@index([planId, fechaProgramada])
  @@index([movimientoId])
  @@index([locomotoraNumero, fechaProgramada])
  @@index([estado])
}

model EventoOperativoComercial {
  id               BigInt   @id @default(autoincrement())
  eventId          String   @unique @db.Uuid
  tipo             String
  empresaId        Int
  movimientoId     Int?
  localidadId      Int?
  locomotoraNumero Int?
  ocurridoAt       DateTime
  versionOrigen    Int      @default(1)
  payload          Json
  procesadoAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([empresaId, ocurridoAt])
  @@index([movimientoId, ocurridoAt])
  @@index([tipo, ocurridoAt])
}

model PaqueteComercial {
  id                 Int                       @id @default(autoincrement())
  clienteComercialId Int
  contratoId         Int?
  tarifaExcedenteId  Int?
  nombre             String
  servicio           TipoServicioComercial
  origenOperacion    OrigenOperacionComercial?
  unidad             UnidadCobro               @default(EVENTO)
  periodicidad       PeriodicidadPaquete       @default(MENSUAL)
  localidadId        Int?
  estadosIncluidos   String[]                  @default(["CONCLUIDO"])
  cantidadIncluida   Decimal?                  @db.Decimal(12, 2)
  montoPaquete       Decimal?                  @db.Decimal(14, 2)
  importeExcedente   Decimal?                  @db.Decimal(14, 2)
  moneda             String                    @default("MXN") @db.VarChar(3)
  vigenciaInicio     DateTime
  vigenciaFin        DateTime?
  activo             Boolean                   @default(true)
  notas              String?
  createdById        Int
  updatedById        Int
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  cliente         ClienteComercial   @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  contrato        ContratoComercial? @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  tarifaExcedente TarifaCliente?     @relation(fields: [tarifaExcedenteId], references: [id], onDelete: SetNull)

  @@index([clienteComercialId, activo, vigenciaInicio])
  @@index([contratoId])
  @@index([servicio, origenOperacion, localidadId])
}

model CorteCobro {
  id                 Int              @id @default(autoincrement())
  clienteComercialId Int
  contratoId         Int?
  folio              String           @unique
  periodoInicio      DateTime
  periodoFin         DateTime
  fechaCorte         DateTime
  fechaVencimiento   DateTime?
  estado             EstadoCorteCobro @default(BORRADOR)
  subtotal           Decimal?         @db.Decimal(14, 2)
  iva                Decimal?         @db.Decimal(14, 2)
  total              Decimal?         @db.Decimal(14, 2)
  moneda             String           @default("MXN") @db.VarChar(3)
  facturaFolio       String?
  facturaUuid        String?          @db.Uuid
  facturaPdfUrl      String?
  facturaXmlUrl      String?
  notas              String?
  aprobadoPorId      Int?
  aprobadoAt         DateTime?
  createdById        Int
  updatedById        Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  cliente   ClienteComercial    @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  contrato  ContratoComercial?  @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  detalles  CorteCobroDetalle[]
  pagos     PagoCobranza[]
  gestiones GestionCobranza[]

  @@index([clienteComercialId, estado, fechaCorte])
  @@index([contratoId])
  @@index([fechaVencimiento, estado])
}

model CorteCobroDetalle {
  id               Int                      @id @default(autoincrement())
  corteId          Int
  fuente           OrigenOperacionComercial
  fuenteId         String
  servicio         TipoServicioComercial
  localidadId      Int?
  locomotoraNumero Int?
  referencia       String?
  fechaServicio    DateTime
  cantidad         Decimal                  @default(1) @db.Decimal(12, 2)
  importeUnitario  Decimal?                 @db.Decimal(14, 2)
  subtotal         Decimal?                 @db.Decimal(14, 2)
  estadoCobro      EstadoCobroComercial     @default(PENDIENTE_VALIDACION)
  motivoNoCobro    String?
  evidencia        Json?
  createdById      Int
  updatedById      Int
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  corte CorteCobro @relation(fields: [corteId], references: [id], onDelete: Cascade)

  @@unique([corteId, fuente, fuenteId, servicio])
  @@index([corteId, estadoCobro])
  @@index([localidadId, fechaServicio])
  @@index([locomotoraNumero, fechaServicio])
}

model PagoCobranza {
  id              Int      @id @default(autoincrement())
  corteId         Int
  monto           Decimal  @db.Decimal(14, 2)
  fechaPago       DateTime
  referencia      String?
  metodo          String?
  comprobanteUrl  String?
  notas           String?
  registradoPorId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  corte CorteCobro @relation(fields: [corteId], references: [id], onDelete: Restrict)

  @@index([corteId, fechaPago])
  @@index([fechaPago])
}

model GestionCobranza {
  id                 Int                   @id @default(autoincrement())
  clienteComercialId Int
  corteId            Int?
  estado             EstadoGestionCobranza @default(PENDIENTE)
  asunto             String
  nota               String
  fechaContacto      DateTime              @default(now())
  fechaCompromiso    DateTime?
  montoPrometido     Decimal?              @db.Decimal(14, 2)
  contactoNombre     String?
  createdById        Int
  updatedById        Int
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  cliente ClienteComercial @relation(fields: [clienteComercialId], references: [id], onDelete: Restrict)
  corte   CorteCobro?      @relation(fields: [corteId], references: [id], onDelete: SetNull)

  @@index([clienteComercialId, estado, fechaContacto])
  @@index([corteId])
  @@index([fechaCompromiso, estado])
}

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://usuario:password@127.0.0.1:5432/cosaif?schema=public

# Empiece en compat, valide orígenes reales y después cambie a enforce en producción.
CORS_MODE=compat
CORS_ORIGINS=https://app.ejemplo.com,https://admin.ejemplo.com
CORS_CREDENTIALS=true

# Redis comparte el bloqueo de login entre instancias. Sin REDIS_URL cae a memoria local.
REDIS_URL=redis://127.0.0.1:6379
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_MAX_FAILURES=12
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_BLOCK_MS=900000
AUTH_LOGIN_REDIS_PREFIX=cosaif:auth:login:v1
AUTH_LOGIN_REDIS_CONNECT_TIMEOUT_MS=800

# Auditoría append-only con cadena HMAC. Use una llave distinta al JWT_SECRET.
AUDIT_ENABLED=true
AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters
AUDIT_LOG_PATH=logs/security-audit.jsonl

# Canal saliente autenticado hacia Medidor. Use un secreto distinto por servicio.
GUARDIAN_SOCKET_URL=http://127.0.0.1:4100/agents
GUARDIAN_AGENT_SECRET=replace-with-at-least-32-random-characters
GUARDIAN_TELEMETRY_INTERVAL_SECONDS=10
